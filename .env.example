APP_NAME=Laravel
APP_ENV=local
APP_KEY=base64:fYxbmKDL87S4m28PtdWEg9jbkmTw8tALplgkIvDCqMA=
APP_DEBUG=true
APP_URL=http://localhost:8086
APP_PORT=8086
VITE_PORT=5175
PMA_PORT=8084
 
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12
 
LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug
 
# --- MySQL ---
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=laravel
DB_USERNAME=laravel
DB_PASSWORD=secret
DB_ROOT_PASSWORD=root
 
# --- Redis ---
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=null
 
CACHE_STORE=redis
SESSION_DRIVER=redis
SESSION_LIFETIME=120
 
# --- Queue / RabbitMQ ---
QUEUE_CONNECTION=rabbitmq
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest
RABBITMQ_VHOST=/
RABBITMQ_QUEUE=default
RABBITMQ_EXCHANGE=comments

BROADCAST_CONNECTION=reverb
REVERB_APP_ID=local-app
REVERB_APP_KEY=local-key
REVERB_APP_SECRET=local-secret
# для PHP внутри docker-сети

REVERB_SCHEME=http
REVERB_SERVER_HOST=0.0.0.0
# PHP → Reverb внутри docker-сети (порт контейнера, не меняется)
REVERB_HOST=reverb
REVERB_PORT=8080
REVERB_SERVER_PORT=8080

# Порт на вашей машине (его вы меняете при конфликте)
REVERB_FORWARD_PORT=8085

# Браузер → Reverb (должен совпадать с портом на хосте)

VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST=localhost
VITE_REVERB_PORT="${REVERB_FORWARD_PORT}"
VITE_REVERB_SCHEME=http

VITE_USE_POLLING=false


FILESYSTEM_DISK=local
 
MAIL_MAILER=log
 
# --- Google reCAPTCHA ---
RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=
 
VITE_APP_NAME="${APP_NAME}"
UID=1000
GID=1000

# Тестовые ключи Google: капча всегда проходит (только для разработки!)
RECAPTCHA_SITE_KEY=6LeIxAcTAAAAAJcZVRqyHh71UMIEGNQ_MXjiZKhI
RECAPTCHA_SECRET_KEY=6LeIxAcTAAAAAGG-vFI1TnRWxMZNFuojJ4WifJWe

COMMENTS_PER_PAGE=25
COMMENTS_CACHE_TTL=600

ELASTICSEARCH_ENABLED=true
ELASTICSEARCH_HOST=http://elasticsearch:9200
ELASTICSEARCH_INDEX=comments

# Заголовки безопасности (config/security.php)
CSP_ENABLED=true
CSP_REPORT_ONLY=false
